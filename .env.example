# Copy to .env.local. Never commit real keys.

# mock    = runs locally with no keys (default)
# foundry = Microsoft Foundry (Azure OpenAI v1 API)
AI_PROVIDER=mock

# --- Needed when AI_PROVIDER=foundry ---
# Your resource endpoint with /openai/v1 on the end. Either form works:
#   https://<resource>.openai.azure.com/openai/v1
#   https://<resource>.services.ai.azure.com/openai/v1
FOUNDRY_BASE_URL=
# Foundry portal > your resource > Keys and Endpoint
FOUNDRY_API_KEY=
# The deployment NAME (not the model family) used for challenge values and feedback
FOUNDRY_CHAT_DEPLOYMENT=
# Optional: a vision-capable deployment for photos. Defaults to FOUNDRY_CHAT_DEPLOYMENT.
FOUNDRY_VISION_DEPLOYMENT=
