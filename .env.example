# Copy to .env.local. Never commit real keys.

# mock    = runs locally with no keys (default)
# foundry = Microsoft Foundry (Azure OpenAI v1 API)
AI_PROVIDER=mock

# --- Needed when AI_PROVIDER=foundry ---
# Your resource endpoint with /openai/v1 on the end. Either form works:
#   https://<resource>.openai.azure.com/openai/v1
#   https://<resource>.services.ai.azure.com/openai/v1
FOUNDRY_BASE_URL=
# Foundry portal > your resource > Keys and Endpoint
FOUNDRY_API_KEY=
# The deployment NAME (not the model family) used for challenge values and feedback
FOUNDRY_CHAT_DEPLOYMENT=
# Optional: a vision-capable deployment for photos. Defaults to FOUNDRY_CHAT_DEPLOYMENT.
FOUNDRY_VISION_DEPLOYMENT=

# --- Content safety (screens every learner input and model output) ---
# stub  = keyword check for offline demos only (default). NOT a safety system.
# azure = Azure AI Content Safety
CONTENT_SAFETY_PROVIDER=stub
# Azure portal > your Content Safety resource > Keys and Endpoint, e.g. https://<resource>.cognitiveservices.azure.com
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
# Flag at this severity or above: 2 (low, default, cautious for minors), 4 (medium) or 6 (high)
CONTENT_SAFETY_THRESHOLD=2

# --- Facilitator view (/facilitator) ---
# Any username; this password. The view stays closed until it is set.
FACILITATOR_PASSWORD=

# --- Embedding in P2E ---
# The P2E origin allowed to embed SkillLens and receive saved samples, e.g. https://unicef.myp2e.org
# Leave empty for the local demo (same origin only).
NEXT_PUBLIC_P2E_ORIGIN=

# --- Yoma ---
# mock = build the exact Yoma request and show a preview, send nothing (default)
# live = send to Yoma with the learner's own Yoma access token
YOMA_MODE=mock
YOMA_API_BASE_URL=https://v3api.stage.yoma.world/api/v3
# SkillLens course id -> the Yoma opportunity id an org admin created for it
# YOMA_OPPORTUNITY_IDS=financial-literacy:<guid>,job-readiness:<guid>
YOMA_OPPORTUNITY_IDS=
